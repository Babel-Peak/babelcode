{
  "name": "babel-code",
  "displayName": "Babel Code",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.7.14",
  "icon": "assets/icons/logo-outline-black.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "babelcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Babel-Peak/babelcode.git",
    "directory": "packages/kilo-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Babel Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "kilo",
    "Babel Code",
    "kilocode",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "opencode",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "kilo-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "kilo-logo": {
        "description": "Babel Code logo",
        "default": {
          "fontPath": "assets/icons/kilo-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "babel-code-ActivityBar",
          "title": "Babel Code",
          "icon": "assets/icons/kilo-light.png",
          "darkIcon": "assets/icons/kilo-dark.png"
        }
      ]
    },
    "views": {
      "babel-code-ActivityBar": [
        {
          "type": "webview",
          "id": "babel-code.SidebarProvider",
          "name": "Babel Code"
        }
      ]
    },
    "commands": [
      {
        "command": "babel-code.new.cloud.signIn",
        "title": "Sign in to Babel Code Cloud",
        "category": "Babel Code"
      },
      {
        "command": "babel-code.new.plusButtonClicked",
        "title": "New Task",
        "category": "Babel Code",
        "icon": "$(add)"
      },
      {
        "command": "babel-code.new.agentManagerOpen",
        "title": "Agent Manager",
        "category": "Babel Code",
        "icon": "$(organization)"
      },
      {
        "command": "babel-code.new.kiloClawOpen",
        "title": "KiloClaw",
        "category": "Babel Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "babel-code.new.browserPreview.open",
        "title": "Open Browser Preview",
        "category": "Babel Code",
        "icon": "$(globe)"
      },
      {
        "command": "babel-code.new.marketplaceButtonClicked",
        "title": "Marketplace",
        "category": "Babel Code",
        "icon": "$(extensions)"
      },
      {
        "command": "babel-code.new.historyButtonClicked",
        "title": "History",
        "category": "Babel Code",
        "icon": "$(history)"
      },
      {
        "command": "babel-code.new.profileButtonClicked",
        "title": "Profile",
        "category": "Babel Code",
        "icon": "$(account)"
      },
