    "submenus": [
      {
        "id": "babel-code.new.editorContextMenu",
        "label": "Babel Code"
      },
      {
        "id": "babel-code.new.terminalContextMenu",
        "label": "Babel Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "babel-code.new.addFileToContext",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.kiloClawOpen",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.browserPreviewOpen",
          "when": "false"
        },
        {
          "command": "babel-code.new.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "babel-code.new.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "babel-code.new.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@3",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.sidebarTitle.browserPreviewOpen",
          "group": "navigation@4",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.sidebarTitle.settingsButtonClicked",
          "group": "navigation@5",
          "when": "view == babel-code.SidebarProvider && !babel-code.new.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "babel-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "babel-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "babel-code.new.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "babel-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == babel-code.new.TabPanel && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == babel-code.new.TabPanel && !babel-code.new.isCursor"
        },
        {
          "command": "babel-code.new.settingsButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == babel-code.new.TabPanel && !babel-code.new.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "babel-code.new.editorContextMenu",
          "group": "1_kilocode"
        }
      ],
      "babel-code.new.editorContextMenu": [
        {
          "command": "babel-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "babel-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "babel-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "babel-code.new.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "babel-code.new.terminalContextMenu",
          "group": "2_kilocode"
        }
      ],
      "babel-code.new.terminalContextMenu": [
        {
          "command": "babel-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "babel-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "babel-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ],
      "explorer/context": [
        {
          "command": "babel-code.new.addFileToContext",
          "group": "1_kilocode"
        }
      ]
    },
    "keybindings": [
      {
        "command": "babel-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "babel-code.new.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "babel-code.new.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "babel-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "babel-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "babel-code.new.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "babel-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && !babel-code.new.sidebarFocused"
      },
      {
        "command": "babel-code.new.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "babel-code.new.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && !babel-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "babel-code.new.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && !babel-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "babel-code.new.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' && babel-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "babel-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'babel-code.new.AgentManagerPanel'"
      },
      {
        "command": "babel-code.new.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "babel-code.new.sidebarFocused || activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' || activeWebviewPanelId == 'babel-code.new.TabPanel'"
      },
      {
        "command": "babel-code.new.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "babel-code.new.sidebarFocused || activeWebviewPanelId == 'babel-code.new.AgentManagerPanel' || activeWebviewPanelId == 'babel-code.new.TabPanel'"
      },
      {
        "command": "babel-code.new.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && babel-code.new.autocomplete.hasSuggestions"
      },
      {
        "command": "babel-code.new.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && babel-code.new.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "babel-code.new.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && babel-code.new.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "babel-code.new.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && babel-code.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "babel-code.new.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && babel-code.nextEdit.hasPendingSuggestion"
      }
    ],
